# LLM: use OpenAI platform credits OR Azure OpenAI (not both required).
# auto = prefer OPENAI_API_KEY if set, else Azure.
LLM_PROVIDER=auto

# OpenAI platform (https://platform.openai.com/api-keys) — use your $ credits here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI (optional; typical for Azure Container Apps)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Tavily (required for Hybrid / Web modes)
TAVILY_API_KEY=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=engineering-knowledge-assistant

# App
RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
