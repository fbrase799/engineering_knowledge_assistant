# Shared configuration for every script under azure/.
# Scripts source this file; override any value by exporting it before running.

# -------- Azure target --------
AZ_LOCATION="${AZ_LOCATION:-westeurope}"
AZ_RESOURCE_GROUP="${AZ_RESOURCE_GROUP:-rg-engineering-knowledge}"
AZ_ENVIRONMENT="${AZ_ENVIRONMENT:-eka-env}"
AZ_LOG_ANALYTICS="${AZ_LOG_ANALYTICS:-eka-logs}"

# -------- Container app names --------
APP_BACKEND="${APP_BACKEND:-backend}"
APP_FRONTEND="${APP_FRONTEND:-frontend}"

# -------- Images (GitHub Container Registry) --------
GHCR_OWNER="${GHCR_OWNER:-fbrase799}"
IMAGE_TAG="${IMAGE_TAG:-latest}"
IMAGE_BACKEND="${IMAGE_BACKEND:-ghcr.io/${GHCR_OWNER}/engineering_knowledge_assistant-backend:${IMAGE_TAG}}"
IMAGE_FRONTEND="${IMAGE_FRONTEND:-ghcr.io/${GHCR_OWNER}/engineering_knowledge_assistant-frontend:${IMAGE_TAG}}"

# -------- OIDC / AAD bootstrap (used only by 00-bootstrap-oidc.sh) --------
AAD_APP_NAME="${AAD_APP_NAME:-gh-engineering-knowledge-deployer}"
GH_REPO="${GH_REPO:-fbrase799/engineering_knowledge_assistant}"
GH_DEPLOY_REF="${GH_DEPLOY_REF:-refs/heads/main}"
